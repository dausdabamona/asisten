    "typescript": "^5.0.0",
    "vite": "^5.4.11"
  },
  "dependencies": {
    "@prisma/client": "^6.8.0",
    "@types/archiver": "^7.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "archiver": "^7.0.1",
