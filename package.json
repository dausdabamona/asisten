{
  "name": "asisten",
  "version": "2.0.0",
  "description": "ASISTEN - Phase 1 + Phase 2: Travel & Treasury Module for PostgreSQL",
  "main": "src/main/main.js",
  "scripts": {
    "build:renderer": "vite build",
    "build:electron": "electron-builder --config electron-builder.yml",
    "build:exe": "npm run build:renderer && npm run build:electron",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:prod": "set NODE_ENV=production && node dist/server.js",
    "start:electron": "electron src/main/main.js",
    "dev": "ts-node src/server.ts",
    "setup": "prisma generate && prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:seed": "ts-node prisma/seed.ts",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "prisma:format": "prisma format",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "http://local_proxy@127.0.0.1:50149/git/dausdabamona/asisten"
  },
  "keywords": [
    "postgresql",
    "prisma",
    "workflow",
    "document-management",
    "sppd",
    "finance",
    "treasury",
    "travel-management"
  ],
  "author": "",
  "license": "ISC",
