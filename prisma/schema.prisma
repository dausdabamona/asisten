// =============================================================================
// ASISTEN - Phase 1 + Phase 2 + Phase 3: Travel, Treasury & Procurement Module
// PostgreSQL Database Schema using Prisma ORM
// Schema Name: asisten
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["asisten"]
}

// =============================================================================
// ENUMS - Core States
// =============================================================================

enum WorkflowState {
  PERENCANAAN
  PERSIAPAN
  KONTRAK
  PELAKSANAAN
  PEMBAYARAN
  ARSIP

  @@schema("asisten")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  REVISION_REQUESTED

  @@schema("asisten")
}

// =============================================================================
// ENUMS - Document Types (Phase 2 Extended)
// =============================================================================

enum DokumenTipe {
  // Phase 1 types
  KONTRAK
  ADENDUM
  SURAT_TUGAS
  SPPD
  KUITANSI
  LAPORAN
  BERITA_ACARA
  LAINNYA
  // Phase 2 additions
  KUITANSI_UM       // Kuitansi Uang Muka
  KUITANSI_RAMPUNG  // Kuitansi Rampung/Final
  LAPORAN_SPPD      // Laporan Perjalanan Dinas
  SPJ_UP            // SPJ Uang Persediaan
  SPJ_TUP           // SPJ Tambahan Uang Persediaan
  // Phase 3 additions - Procurement
  KAK               // Kerangka Acuan Kerja
  HPS               // Harga Perkiraan Sendiri
  RANCANGAN_KONTRAK
  SSUK              // Syarat-Syarat Umum Kontrak
  SSKK              // Syarat-Syarat Khusus Kontrak
  SPMK              // Surat Perintah Mulai Kerja
  ADENDUM_KONTRAK
  BA_KEMAJUAN       // Berita Acara Kemajuan
  BAHP              // Berita Acara Hasil Pemeriksaan
  BAST              // Berita Acara Serah Terima
  // Phase 3 additions - Payment
  SPP               // Surat Permintaan Pembayaran
  SPM               // Surat Perintah Membayar
  SP2D              // Surat Perintah Pencairan Dana

  @@schema("asisten")
}

enum DokumenRelasiTipe {
  ADENDUM
  REVISI
  LAMPIRAN
  REFERENSI

  @@schema("asisten")
}

// =============================================================================
// ENUMS - Travel Status (Phase 2 Enhanced)
// =============================================================================

enum PerjalananStatus {
  DRAFT
  DIAJUKAN
  DISETUJUI
  BERLANGSUNG
  SELESAI
  DIBATALKAN

  @@schema("asisten")
}

enum SuratTugasStatus {
  DRAFT
  MENUNGGU_APPROVAL
  APPROVED
  REJECTED
  FINAL

  @@schema("asisten")
}

enum SppdStatus {
  DRAFT
  MENUNGGU_ST        // Waiting for Surat Tugas approval
  TERBIT
  BERLANGSUNG
  SELESAI
  DIBATALKAN

  @@schema("asisten")
}

// =============================================================================
// ENUMS - Treasury Status (Phase 2)
// =============================================================================

enum TreasuryType {
  UP    // Uang Persediaan
  TUP   // Tambahan Uang Persediaan

  @@schema("asisten")
}

enum KuitansiTipe {
  UANG_MUKA   // Advance payment receipt
  RAMPUNG     // Final settlement receipt
  OPERASIONAL // General operational expense

  @@schema("asisten")
}

enum PembayaranStatus {
  DRAFT
  DIAJUKAN
  DIVERIFIKASI
  DIBAYAR
  DITOLAK

  @@schema("asisten")
}

enum SPJStatus {
  DRAFT
  DIAJUKAN
  DIPERIKSA
  DIVERIFIKASI
  DISAHKAN
  DITOLAK
  SELESAI

  @@schema("asisten")
}

// =============================================================================
// ENUMS - Procurement Status (Phase 3)
// =============================================================================

enum KAKStatus {
  DRAFT
  MENUNGGU_APPROVAL
  APPROVED
  REJECTED
  FINAL

  @@schema("asisten")
}

enum HPSStatus {
  DRAFT
  MENUNGGU_APPROVAL
  APPROVED
  REJECTED
  FINAL

  @@schema("asisten")
}

enum KontrakStatus {
  DRAFT
  NEGOSIASI
  MENUNGGU_TTD      // Menunggu tanda tangan
  AKTIF
  SELESAI
  DIBATALKAN
  DIPUTUS           // Terminated

  @@schema("asisten")
}

enum SPMKStatus {
  DRAFT
  TERBIT
  BERLANGSUNG
  SELESAI
  DIBATALKAN

  @@schema("asisten")
}

enum BASTStatus {
  DRAFT
  DIAJUKAN
  DIPERIKSA         // Under review (BAHP)
  DIVERIFIKASI
  DITERIMA          // Accepted
  DITOLAK

  @@schema("asisten")
}

enum SPPStatus {
  DRAFT
  DIAJUKAN
  DIVERIFIKASI
  APPROVED
  REJECTED
  TERBIT_SPM        // SPM has been issued

  @@schema("asisten")
}

enum SPMStatus {
  DRAFT
  TERBIT
  DIAJUKAN_SP2D
  SELESAI

  @@schema("asisten")
}

enum SP2DStatus {
  DRAFT
  TERBIT
  DICAIRKAN         // Disbursed
  SELESAI

  @@schema("asisten")
}

enum JenisPengadaan {
  BARANG
  JASA_KONSULTANSI
  JASA_LAINNYA
  PEKERJAAN_KONSTRUKSI

  @@schema("asisten")
}

enum MetodePengadaan {
  PENGADAAN_LANGSUNG
  PENUNJUKAN_LANGSUNG
  TENDER
  SELEKSI
  E_PURCHASING

  @@schema("asisten")
}

// =============================================================================
// ENUMS - Document Signing (Phase 3)
// =============================================================================

enum SignedMethod {
  MANUAL_SCAN   // Manually signed and scanned document

  @@schema("asisten")
}

// =============================================================================
// SECURITY TABLES (1-3)
// =============================================================================

/// Table 1: Users - Core user management
model users {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  username   String   @unique @db.VarChar(100)
  email      String   @unique @db.VarChar(255)
  password   String   @db.VarChar(255)
  nama       String   @db.VarChar(255)
  nip        String?  @db.VarChar(50)
  jabatan    String?  @db.VarChar(255)
  unit_kerja String?  @db.VarChar(255)
  is_active  Boolean  @default(true)
  last_login DateTime?

  // Standard audit fields
  created_at DateTime  @default(now())
  created_by String?   @db.Uuid
  updated_at DateTime  @updatedAt
  updated_by String?   @db.Uuid
  is_deleted Boolean   @default(false)

  // Relations
  user_roles              user_roles[]
  created_paket           paket[]                   @relation("PaketCreatedBy")
  updated_paket           paket[]                   @relation("PaketUpdatedBy")
  created_kegiatan        kegiatan[]                @relation("KegiatanCreatedBy")
  updated_kegiatan        kegiatan[]                @relation("KegiatanUpdatedBy")
  created_workflow_inst   workflow_instance[]       @relation("WorkflowInstanceCreatedBy")
  updated_workflow_inst   workflow_instance[]       @relation("WorkflowInstanceUpdatedBy")
  created_dokumen         dokumen[]                 @relation("DokumenCreatedBy")
  updated_dokumen         dokumen[]                 @relation("DokumenUpdatedBy")
  created_dokumen_versi   dokumen_versi[]           @relation("DokumenVersiCreatedBy")
  approval_logs           approval_log[]            @relation("ApprovalLogApprover")
  audit_logs              audit_log[]               @relation("AuditLogActor")
  perjalanan_created      perjalanan_dinas[]        @relation("PerjalananCreatedBy")
  perjalanan_updated      perjalanan_dinas[]        @relation("PerjalananUpdatedBy")
  peserta_perjalanan      peserta_perjalanan[]
  surat_tugas_created     surat_tugas[]             @relation("SuratTugasCreatedBy")
  surat_tugas_updated     surat_tugas[]             @relation("SuratTugasUpdatedBy")
  surat_tugas_penanda     surat_tugas[]             @relation("SuratTugasPenandaTangan")
  sppd_created            sppd[]                    @relation("SppdCreatedBy")
  sppd_updated            sppd[]                    @relation("SppdUpdatedBy")
  sppd_pejabat            sppd[]                    @relation("SppdPejabat")
  up_created              uang_persediaan[]         @relation("UPCreatedBy")
  up_updated              uang_persediaan[]         @relation("UPUpdatedBy")
  up_bendahara            uang_persediaan[]         @relation("UPBendahara")
  tup_created             tambahan_uang_persediaan[] @relation("TUPCreatedBy")
  tup_updated             tambahan_uang_persediaan[] @relation("TUPUpdatedBy")
  tup_bendahara           tambahan_uang_persediaan[] @relation("TUPBendahara")
  kuitansi_created        kuitansi[]                @relation("KuitansiCreatedBy")
  kuitansi_updated        kuitansi[]                @relation("KuitansiUpdatedBy")
  spj_created             pertanggungjawaban[]      @relation("SPJCreatedBy")
  spj_updated             pertanggungjawaban[]      @relation("SPJUpdatedBy")
  spj_verifikator         pertanggungjawaban[]      @relation("SPJVerifikator")
  spj_pengesah            pertanggungjawaban[]      @relation("SPJPengesah")
  // Phase 3 relations
  kak_created             kak[]                     @relation("KAKCreatedBy")
  kak_updated             kak[]                     @relation("KAKUpdatedBy")
  kak_ppk                 kak[]                     @relation("KAKPejabatPPK")
  hps_created             hps[]                     @relation("HPSCreatedBy")
  hps_updated             hps[]                     @relation("HPSUpdatedBy")
  hps_penyusun            hps[]                     @relation("HPSPenyusun")
  kontrak_created         kontrak[]                 @relation("KontrakCreatedBy")
  kontrak_updated         kontrak[]                 @relation("KontrakUpdatedBy")
  kontrak_ppk             kontrak[]                 @relation("KontrakPPK")
  spmk_created            spmk[]                    @relation("SPMKCreatedBy")
  spmk_updated            spmk[]                    @relation("SPMKUpdatedBy")
  spmk_ppk                spmk[]                    @relation("SPMKPejabatPPK")
  bast_created            bast[]                    @relation("BASTCreatedBy")
  bast_updated            bast[]                    @relation("BASTUpdatedBy")
  bast_ppk                bast[]                    @relation("BASTPejabatPPK")
  bast_penerima           bast[]                    @relation("BASTPenerima")
  spp_created             spp[]                     @relation("SPPCreatedBy")
  spp_updated             spp[]                     @relation("SPPUpdatedBy")
  spp_ppk                 spp[]                     @relation("SPPPejabatPPK")
  spm_created             spm[]                     @relation("SPMCreatedBy")
  spm_updated             spm[]                     @relation("SPMUpdatedBy")
  spm_kuasa_pa            spm[]                     @relation("SPMKuasaPA")
  sp2d_created            sp2d[]                    @relation("SP2DCreatedBy")
  sp2d_updated            sp2d[]                    @relation("SP2DUpdatedBy")
  sp2d_kuasa_bud          sp2d[]                    @relation("SP2DKuasaBUD")
  rekening_created        rekening_penyedia[]       @relation("RekeningCreatedBy")
  rekening_updated        rekening_penyedia[]       @relation("RekeningUpdatedBy")

  @@index([username])
  @@index([email])
  @@index([is_deleted])
  @@schema("asisten")
}

/// Table 2: Roles - Role definitions
model roles {
  id          String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  kode        String  @unique @db.VarChar(50)
  nama        String  @db.VarChar(100)
  deskripsi   String? @db.Text
  level       Int     @default(0)
  permissions Json?

  // Standard audit fields
  created_at DateTime @default(now())
  created_by String?  @db.Uuid
  updated_at DateTime @updatedAt
  updated_by String?  @db.Uuid
  is_deleted Boolean  @default(false)

  // Relations
  user_roles       user_roles[]
  approval_logs    approval_log[]
  workflow_actions workflow_action[]

  @@index([kode])
  @@index([is_deleted])
  @@schema("asisten")
}

/// Table 3: User Roles - Many-to-many user-role assignments
model user_roles {
  id      String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id String @db.Uuid
  role_id String @db.Uuid

  // Standard audit fields
  created_at DateTime @default(now())
  created_by String?  @db.Uuid
  updated_at DateTime @updatedAt
  updated_by String?  @db.Uuid
  is_deleted Boolean  @default(false)

  // Relations
  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role roles @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@unique([user_id, role_id])
  @@index([user_id])
  @@index([role_id])
  @@index([is_deleted])
  @@schema("asisten")
}

// =============================================================================
// BUSINESS OBJECT TABLES (4-5)
// =============================================================================

/// Table 4: Paket - Main business package/project
model paket {
  id               String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  kode             String   @unique @db.VarChar(50)
  nama             String   @db.VarChar(500)
  deskripsi        String?  @db.Text
  tahun_anggaran   Int
  nilai_pagu       Decimal  @db.Decimal(18, 2)
  nilai_kontrak    Decimal? @db.Decimal(18, 2)
  tanggal_mulai    DateTime?
  tanggal_selesai  DateTime?
  lokasi           String?  @db.VarChar(500)
  kegiatan_id      String?  @db.Uuid

  // Standard audit fields
  created_at DateTime @default(now())
  created_by String?  @db.Uuid
  updated_at DateTime @updatedAt
  updated_by String?  @db.Uuid
  is_deleted Boolean  @default(false)

  // Relations
  kegiatan          kegiatan?           @relation(fields: [kegiatan_id], references: [id])
  creator           users?              @relation("PaketCreatedBy", fields: [created_by], references: [id])
  updater           users?              @relation("PaketUpdatedBy", fields: [updated_by], references: [id])
  workflow_instance workflow_instance?  // One paket has one workflow_instance
  dokumen           dokumen[]
  perjalanan_dinas  perjalanan_dinas[]
  uang_persediaan   uang_persediaan[]
  tambahan_up       tambahan_uang_persediaan[]
  // Phase 3 relations
  kak               kak[]
  hps               hps[]
  kontrak           kontrak[]
  spmk              spmk[]
  bast              bast[]
  spp               spp[]
  spm               spm[]
  sp2d              sp2d[]

  @@index([kode])
  @@index([tahun_anggaran])
  @@index([kegiatan_id])
  @@index([is_deleted])
  @@schema("asisten")
}

/// Table 5: Kegiatan - Activity/Program grouping
model kegiatan {
  id              String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  kode            String   @unique @db.VarChar(50)
  nama            String   @db.VarChar(500)
  deskripsi       String?  @db.Text
  tahun_anggaran  Int
  pagu_anggaran   Decimal  @db.Decimal(18, 2)
  unit_kerja      String?  @db.VarChar(255)
  program         String?  @db.VarChar(500)

  // Standard audit fields
  created_at DateTime @default(now())
  created_by String?  @db.Uuid
  updated_at DateTime @updatedAt
  updated_by String?  @db.Uuid
  is_deleted Boolean  @default(false)

  // Relations
  creator users?  @relation("KegiatanCreatedBy", fields: [created_by], references: [id])
  updater users?  @relation("KegiatanUpdatedBy", fields: [updated_by], references: [id])
  paket   paket[]

  @@index([kode])
  @@index([tahun_anggaran])
  @@index([is_deleted])
  @@schema("asisten")
}

// =============================================================================
// WORKFLOW ENGINE TABLES (6-9)
// =============================================================================

/// Table 6: Workflow Stage - Stage definitions in workflow
model workflow_stage {
  id          String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  kode        WorkflowState @unique
  nama        String        @db.VarChar(100)
  deskripsi   String?       @db.Text
  urutan      Int
  is_initial  Boolean       @default(false)
  is_final    Boolean       @default(false)
  color       String?       @db.VarChar(20)

  // Standard audit fields
  created_at DateTime @default(now())
  created_by String?  @db.Uuid
  updated_at DateTime @updatedAt
  updated_by String?  @db.Uuid
  is_deleted Boolean  @default(false)

  // Relations
  current_instances    workflow_instance[]    @relation("CurrentStage")
  transitions_from     workflow_transition[]  @relation("TransitionFrom")
  transitions_to       workflow_transition[]  @relation("TransitionTo")
  dokumen              dokumen[]
  workflow_actions     workflow_action[]

  @@index([kode])
  @@index([urutan])
  @@index([is_deleted])
  @@schema("asisten")
}

/// Table 7: Workflow Instance - Active workflow for a paket
model workflow_instance {
  id               String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  paket_id         String    @unique @db.Uuid
  current_stage_id String    @db.Uuid
  started_at       DateTime  @default(now())
  completed_at     DateTime?
  is_active        Boolean   @default(true)
  metadata         Json?

  // Standard audit fields
  created_at DateTime @default(now())
  created_by String?  @db.Uuid
  updated_at DateTime @updatedAt
  updated_by String?  @db.Uuid
  is_deleted Boolean  @default(false)

  // Relations
  paket               paket                   @relation(fields: [paket_id], references: [id], onDelete: Cascade)
  current_stage       workflow_stage          @relation("CurrentStage", fields: [current_stage_id], references: [id])
  creator             users?                  @relation("WorkflowInstanceCreatedBy", fields: [created_by], references: [id])
  updater             users?                  @relation("WorkflowInstanceUpdatedBy", fields: [updated_by], references: [id])
  transitions         workflow_transition[]
  perjalanan_dinas    perjalanan_dinas[]      // Phase 2: Link perjalanan to workflow
  pertanggungjawaban  pertanggungjawaban[]    // Phase 2: Link SPJ to workflow

  @@index([paket_id])
  @@index([current_stage_id])
  @@index([is_active])
  @@index([is_deleted])
  @@schema("asisten")
}

/// Table 8: Workflow Transition - Transition history/log
model workflow_transition {
  id                   String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  workflow_instance_id String    @db.Uuid
  from_stage_id        String    @db.Uuid
  to_stage_id          String    @db.Uuid
  transitioned_at      DateTime  @default(now())
  transitioned_by      String?   @db.Uuid
  catatan              String?   @db.Text
  metadata             Json?

  // Standard audit fields
  created_at DateTime @default(now())
  created_by String?  @db.Uuid
  updated_at DateTime @updatedAt
  updated_by String?  @db.Uuid
  is_deleted Boolean  @default(false)

  // Relations
  workflow_instance workflow_instance @relation(fields: [workflow_instance_id], references: [id], onDelete: Cascade)
  from_stage        workflow_stage    @relation("TransitionFrom", fields: [from_stage_id], references: [id])
  to_stage          workflow_stage    @relation("TransitionTo", fields: [to_stage_id], references: [id])

  @@index([workflow_instance_id])
  @@index([from_stage_id])
  @@index([to_stage_id])
  @@index([transitioned_at])
  @@index([is_deleted])
  @@schema("asisten")
}

/// Table 9: Workflow Action - Allowed actions per stage with role requirements (Phase 2)
model workflow_action {
  id                String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  workflow_stage_id String        @db.Uuid
  action_code       String        @db.VarChar(50) // e.g., DRAFT_ST, APPROVE_ST, TERBIT_SPPD
  action_name       String        @db.VarChar(100)
  deskripsi         String?       @db.Text
  required_role_id  String?       @db.Uuid  // Role required to perform this action
  next_stage_id     String?       @db.Uuid  // Stage to transition to after action (if any)
  is_approval       Boolean       @default(false)
  urutan            Int           @default(0)

  // Standard audit fields
  created_at DateTime @default(now())
  created_by String?  @db.Uuid
  updated_at DateTime @updatedAt
  updated_by String?  @db.Uuid
  is_deleted Boolean  @default(false)

  // Relations
  workflow_stage workflow_stage @relation(fields: [workflow_stage_id], references: [id])
  required_role  roles?         @relation(fields: [required_role_id], references: [id])

  @@unique([workflow_stage_id, action_code])
  @@index([workflow_stage_id])
  @@index([action_code])
  @@index([is_deleted])
  @@schema("asisten")
}

// =============================================================================
// DOCUMENT ENGINE TABLES (10-12)
// =============================================================================

/// Table 10: Dokumen - Main document entity
model dokumen {
  id                String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  nomor             String      @db.VarChar(100)
  judul             String      @db.VarChar(500)
  tipe              DokumenTipe
  deskripsi         String?     @db.Text
  paket_id          String      @db.Uuid
  workflow_stage_id String      @db.Uuid
  tanggal_dokumen   DateTime
  current_version   Int         @default(1)
  metadata          Json?

  // Standard audit fields
  created_at DateTime @default(now())
  created_by String?  @db.Uuid
  updated_at DateTime @updatedAt
  updated_by String?  @db.Uuid
  is_deleted Boolean  @default(false)

  // Relations
  paket          paket           @relation(fields: [paket_id], references: [id], onDelete: Cascade)
  workflow_stage workflow_stage  @relation(fields: [workflow_stage_id], references: [id])
  creator        users?          @relation("DokumenCreatedBy", fields: [created_by], references: [id])
  updater        users?          @relation("DokumenUpdatedBy", fields: [updated_by], references: [id])
  versi          dokumen_versi[]
  relasi_parent  dokumen_relasi[] @relation("DokumenParent")
  relasi_child   dokumen_relasi[] @relation("DokumenChild")
  approval_logs  approval_log[]
  // Phase 2: Linkage to SPPD entities
  surat_tugas    surat_tugas[]
  sppd           sppd[]
  kuitansi       kuitansi[]
  // Phase 3: Linkage to Procurement entities
  kak            kak[]
  hps            hps[]
  rancangan_kontrak rancangan_kontrak[]
  kontrak        kontrak[]
  ssuk           ssuk[]
  sskk           sskk[]
  spmk           spmk[]
  adendum_kontrak adendum_kontrak[]
  ba_kemajuan    ba_kemajuan[]
  bahp           bahp[]
  bast           bast[]
  // Phase 3: Linkage to Payment entities
  spp            spp[]
  spm            spm[]
  sp2d           sp2d[]

  @@unique([nomor, paket_id])
  @@index([paket_id])
  @@index([workflow_stage_id])
  @@index([tipe])
  @@index([tanggal_dokumen])
  @@index([is_deleted])
  @@schema("asisten")
}

/// Table 11: Dokumen Versi - Document version history
model dokumen_versi {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  dokumen_id   String   @db.Uuid
  versi        Int
  file_path    String   @db.VarChar(1000)
  file_name    String   @db.VarChar(255)
  file_size    BigInt?
  mime_type    String?  @db.VarChar(100)
  checksum     String?  @db.VarChar(64)
  catatan      String?  @db.Text
  is_current   Boolean  @default(false)
  // Phase 3: Manual Signed Document Upload
  signed_by_name   String?       @db.VarChar(255)
  signed_by_role   String?       @db.VarChar(255)
  signed_date      DateTime?
  signed_method    SignedMethod?
  signed_file_path String?       @db.VarChar(1000)
  signed_file_hash String?       @db.VarChar(64)

  // Standard audit fields
  created_at DateTime @default(now())
  created_by String?  @db.Uuid
  updated_at DateTime @updatedAt
  updated_by String?  @db.Uuid
  is_deleted Boolean  @default(false)

  // Relations
  dokumen       dokumen        @relation(fields: [dokumen_id], references: [id], onDelete: Cascade)
  creator       users?         @relation("DokumenVersiCreatedBy", fields: [created_by], references: [id])
  approval_logs approval_log[] @relation("ApprovalLogDokumenVersi")  // Phase 3: Link approval to version

  @@unique([dokumen_id, versi])
  @@index([dokumen_id])
  @@index([is_current])
  @@index([signed_file_hash])
  @@index([is_deleted])
  @@schema("asisten")
}

/// Table 12: Dokumen Relasi - Document relationships
model dokumen_relasi {
  id                String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  parent_dokumen_id String            @db.Uuid
  child_dokumen_id  String            @db.Uuid
  tipe_relasi       DokumenRelasiTipe
  catatan           String?           @db.Text
  urutan            Int?

  // Standard audit fields
  created_at DateTime @default(now())
  created_by String?  @db.Uuid
  updated_at DateTime @updatedAt
  updated_by String?  @db.Uuid
  is_deleted Boolean  @default(false)

  // Relations
  parent_dokumen dokumen @relation("DokumenParent", fields: [parent_dokumen_id], references: [id], onDelete: Cascade)
  child_dokumen  dokumen @relation("DokumenChild", fields: [child_dokumen_id], references: [id], onDelete: Cascade)

  @@unique([parent_dokumen_id, child_dokumen_id, tipe_relasi])
  @@index([parent_dokumen_id])
  @@index([child_dokumen_id])
  @@index([tipe_relasi])
  @@index([is_deleted])
  @@schema("asisten")
}

