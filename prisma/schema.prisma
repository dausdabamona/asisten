// PHASE 3: PROCUREMENT CONTRACT TABLES (23-33)
// =============================================================================

/// Table 23: KAK - Kerangka Acuan Kerja (Terms of Reference)
model kak {
  id                String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  nomor             String         @unique @db.VarChar(100)
  paket_id          String         @db.Uuid
  dokumen_id        String?        @db.Uuid
  judul             String         @db.VarChar(500)
  latar_belakang    String?        @db.Text
  maksud_tujuan     String?        @db.Text
  sasaran           String?        @db.Text
  ruang_lingkup     String?        @db.Text
  keluaran          String?        @db.Text
  jangka_waktu      Int?           // Duration in days
  spesifikasi       Json?          // Technical specifications
  jenis_pengadaan   JenisPengadaan?
  metode_pengadaan  MetodePengadaan?
  nilai_pagu        Decimal        @db.Decimal(18, 2)
  ppk_id            String?        @db.Uuid
  status            KAKStatus      @default(DRAFT)
