  bahp     bahp?    @relation(fields: [bahp_id], references: [id])
  dokumen  dokumen? @relation(fields: [dokumen_id], references: [id])
  ppk      users?   @relation("BASTPejabatPPK", fields: [ppk_id], references: [id])
  penerima users?   @relation("BASTPenerima", fields: [penerima_id], references: [id])
  creator  users?   @relation("BASTCreatedBy", fields: [created_by], references: [id])
  updater  users?   @relation("BASTUpdatedBy", fields: [updated_by], references: [id])
  spp      spp[]

  @@index([paket_id])
  @@index([kontrak_id])
  @@index([bahp_id])
  @@index([dokumen_id])
  @@index([status])
  @@index([tanggal_bast])
  @@index([is_deleted])
  @@schema("asisten")
}

