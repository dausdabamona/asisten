// =============================================================================
// ASISTEN - Normalized Schema (v3.1)
// SQLite Database with Balanced Normalization (~24 tables)
// Generic document pattern + proper FK relationships + workflow
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// =============================================================================
// 1. USERS & ACCESS CONTROL (3 tables)
// =============================================================================

/// Users - Akun pengguna sistem
model users {
  id         String    @id @default(uuid())
  username   String    @unique
  email      String    @unique
  password   String
  is_active  Boolean   @default(true)
  last_login DateTime?

  // Link ke pegawai (opsional)
  pegawai_id String?   @unique

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  is_deleted Boolean   @default(false)

  // Relations
  pegawai     pegawai?     @relation(fields: [pegawai_id], references: [id])
  user_roles  user_roles[]

  @@index([username])
  @@index([is_deleted])
}

/// Roles - Definisi role/peran
model roles {
  id          String  @id @default(uuid())
  kode        String  @unique
  nama        String
  deskripsi   String?
  level       Int     @default(0)
  permissions String? // JSON: array of permission codes

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  is_deleted Boolean  @default(false)

  // Relations
  user_roles      user_roles[]
  workflow_stages workflow_stage[]  // Stages yang memerlukan role ini

  @@index([kode])
}

/// User Roles - Relasi user-role
model user_roles {
  id      String @id @default(uuid())
  user_id String
  role_id String

  created_at DateTime @default(now())
  is_deleted Boolean  @default(false)

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role roles @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@unique([user_id, role_id])
  @@index([user_id])
  @@index([role_id])
}

// =============================================================================
// 2. WORKFLOW MANAGEMENT (3 tables)
// =============================================================================

/// Workflow Stage - Definisi tahapan workflow
model workflow_stage {
  id              String  @id @default(uuid())
  kode            String  @unique  // PERENCANAAN, PERSIAPAN, PEMILIHAN, KONTRAK, dll
  nama            String
  deskripsi       String?
  urutan          Int     @default(0)

  // Role yang dapat approve di stage ini
  required_role_id String?

  // Konfigurasi
  is_initial      Boolean @default(false)  // Stage awal
  is_final        Boolean @default(false)  // Stage akhir
  allow_reject    Boolean @default(true)
  allow_revisi    Boolean @default(true)

  // Aksi yang tersedia (JSON): [{kode, nama, next_stage_kode}]
  available_actions String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  is_deleted Boolean  @default(false)

  // Relations
  required_role       roles?                @relation(fields: [required_role_id], references: [id])
  workflow_instances  workflow_instance[]
  transitions_from    workflow_transition[] @relation("FromStage")
  transitions_to      workflow_transition[] @relation("ToStage")

  @@index([kode])
  @@index([urutan])
}

/// Workflow Instance - Instance workflow untuk paket/dokumen
model workflow_instance {
  id              String    @id @default(uuid())

  // Target (polymorphic) - bisa paket, dokumen, atau perjalanan
  entity_type     String    // paket, dokumen, perjalanan
  entity_id       String

  current_stage_id String

  started_at      DateTime  @default(now())
  completed_at    DateTime?
  is_active       Boolean   @default(true)

  created_at DateTime @default(now())
  created_by String?
  updated_at DateTime @updatedAt
  is_deleted Boolean  @default(false)

  // Relations
  current_stage workflow_stage        @relation(fields: [current_stage_id], references: [id])
  transitions   workflow_transition[]

  @@unique([entity_type, entity_id])
  @@index([entity_type, entity_id])
  @@index([current_stage_id])
  @@index([is_active])
}

/// Workflow Transition - Riwayat perpindahan stage
model workflow_transition {
  id                    String    @id @default(uuid())
  workflow_instance_id  String

  from_stage_id         String
  to_stage_id           String

  // Siapa yang melakukan transisi
  transitioned_by       String?

  // Aksi yang dilakukan
  action                String?   // APPROVE, REJECT, REVISI, SUBMIT
  catatan               String?

  transitioned_at       DateTime  @default(now())

  // Relations
  workflow_instance workflow_instance @relation(fields: [workflow_instance_id], references: [id], onDelete: Cascade)
  from_stage        workflow_stage    @relation("FromStage", fields: [from_stage_id], references: [id])
  to_stage          workflow_stage    @relation("ToStage", fields: [to_stage_id], references: [id])

  @@index([workflow_instance_id])
  @@index([from_stage_id])
  @@index([to_stage_id])
  @@index([transitioned_at])
}

// =============================================================================
// 3. ORGANISASI & SDM (2 tables: satker, pegawai)
// =============================================================================

/// Satker - Satuan Kerja
model satker {
  id           String  @id @default(uuid())
  kode         String  @unique  // Kode Satker 6 digit
  nama         String
  nama_singkat String?
  kementerian  String?
  alamat       String?
  kota         String?
  provinsi     String?
  telepon      String?
  email        String?
  is_active    Boolean @default(true)

  // Pejabat Satker
  kpa_id       String? // Kuasa Pengguna Anggaran
  kpa_nama     String?
  kpa_nip      String?
  ppk_id       String? // Pejabat Pembuat Komitmen
  ppk_nama     String?
  ppk_nip      String?
  ppspm_id     String? // Pejabat Penanda Tangan SPM
  ppspm_nama   String?
  ppspm_nip    String?
  bendahara_id String? // Bendahara Pengeluaran
  bendahara_nama String?
  bendahara_nip  String?
  ka_sub_bau_id String? // Kepala Sub Bagian Administrasi Umum
  ka_sub_bau_nama String?
  ka_sub_bau_nip String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  is_deleted Boolean  @default(false)

  // Relations
  pegawai  pegawai[]
  anggaran anggaran[]
  paket    paket[]

  @@index([kode])
  @@index([is_active])
}

/// Pegawai - Data Pegawai
model pegawai {
  id              String    @id @default(uuid())
  nip             String    @unique
  nama            String
  gelar_depan     String?
  gelar_belakang  String?
  tempat_lahir    String?
  tanggal_lahir   DateTime?
  jenis_kelamin   String?   // L/P

  // Kepegawaian
  golongan        String?   // III/a, IV/b, dll
  pangkat         String?
  jabatan         String?
  jenis_jabatan   String?   // STRUKTURAL, FUNGSIONAL, PELAKSANA
  satker_id       String?

  // Sebagai Pejabat (JSON array): [{jenis, nomor_sk, tanggal_sk, tanggal_mulai, tanggal_selesai}]
  jabatan_pejabat String?   // JSON: KPA, PPK, PPSPM, BENDAHARA, dll

  telepon         String?
  email           String?

  // Data Keuangan & Identitas
  npwp            String?
  npwp16          String?
  no_rekening     String?
  nama_bank       String?
  nama_rekening   String?
  no_kk           String?

  status          String    @default("AKTIF")  // AKTIF, CUTI, PENSIUN
  is_active       Boolean   @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  is_deleted Boolean  @default(false)

  // Relations
  satker          satker?           @relation(fields: [satker_id], references: [id])
  user            users?
  peserta_dinas   peserta_dinas[]
  dokumen_pihak   dokumen_pihak[]   // Sebagai pihak di dokumen
  detail_sk       detail_sk[]

  @@index([nip])
  @@index([satker_id])
  @@index([golongan])
}

// =============================================================================
// 4. ANGGARAN & KEGIATAN (2 tables: anggaran, paket)
// =============================================================================

/// Anggaran - DIPA dan Rincian (individual detail items)
model anggaran {
  id              String  @id @default(uuid())
  satker_id       String
  tahun           Int     // Tahun anggaran

  // Struktur Kode
  kode_program    String?
  kode_kegiatan   String?
  kode_output     String?
  kode_komponen   String?
  kode_subkomponen String?
  kode_akun       String  // MAK

  // Uraian
  nama_program    String?
  nama_kegiatan   String?
  nama_output     String?
  nama_komponen   String?
  uraian_subkomponen String?
  nama_akun       String?

  // Detail Item Information
  nomor_item      Int?    // Item number from CSV (0 = header, >0 = detail)
  uraian_item     String? // Specific item description
  volume          Decimal @default(0)
  satuan          String?
  harga_satuan    Decimal @default(0)

  // Nilai
  pagu            Decimal @default(0) // Total value for this item
  realisasi       Decimal @default(0)
  sisa            Decimal @default(0)

  // Monthly POK allocation (POK_NILAI_1 to POK_NILAI_12)
  pok_bulan_01    Decimal @default(0)
  pok_bulan_02    Decimal @default(0)
  pok_bulan_03    Decimal @default(0)
  pok_bulan_04    Decimal @default(0)
  pok_bulan_05    Decimal @default(0)
  pok_bulan_06    Decimal @default(0)
  pok_bulan_07    Decimal @default(0)
  pok_bulan_08    Decimal @default(0)
  pok_bulan_09    Decimal @default(0)
  pok_bulan_10    Decimal @default(0)
  pok_bulan_11    Decimal @default(0)
  pok_bulan_12    Decimal @default(0)

  jenis_belanja   String? // PEGAWAI, BARANG, MODAL, BANSOS
  sumber_dana     String? // RM, PNBP, PHLN
  keterangan      String?
  is_active       Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  is_deleted Boolean  @default(false)

  // Relations
  satker satker  @relation(fields: [satker_id], references: [id])
  paket  paket[]
  paket_anggaran paket_anggaran[]  // Digunakan oleh paket (many-to-many)
  surat_keputusan surat_keputusan[]

  @@unique([satker_id, tahun, kode_output, kode_subkomponen, kode_komponen, kode_akun, nomor_item])
  @@index([satker_id])
  @@index([tahun])
  @@index([kode_akun])
}

/// Penyedia - Data Vendor/Supplier
model penyedia {
  id              String    @id @default(uuid())
  nama            String
  alamat          String?
  kota            String?
  provinsi        String?
  kode_pos        String?
  npwp            String?
  nama_npwp       String?   // Nama sesuai NPWP
  telepon         String?
  email           String?

  // Data Rekening
  nama_bank       String?
  no_rekening     String?
  nama_rekening   String?   // Nama pemilik rekening

  // Kontak Person
  pic_nama        String?
  pic_telepon     String?
  pic_email       String?

  keterangan      String?
  is_active       Boolean   @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  is_deleted Boolean  @default(false)

  // Relations
  paket           paket[]

  @@index([nama])
  @@index([npwp])
}

/// Paket - Paket Pekerjaan/Pengadaan
model paket {
  id              String    @id @default(uuid())
  kode            String    @unique
  nama            String
  deskripsi       String?
  tahun           Int
  satker_id       String?
  anggaran_id     String?
  penyedia_id     String?   // Link ke penyedia terpilih

  // Nilai
  pagu            Decimal   @default(0)
  nilai_negosiasi Decimal?  // Nilai setelah negosiasi
  nilai_kontrak   Decimal?  // Nilai kontrak final

  // Periode
  tanggal_mulai   DateTime?
  tanggal_selesai DateTime?
  lokasi          String?

  // Jenis & Metode Pengadaan
  jenis_pengadaan   String?  // BARANG, JASA_KONSULTANSI, JASA_LAINNYA, KONSTRUKSI
  metode_pengadaan  String?  // LANGSUNG, PENUNJUKAN, TENDER, SELEKSI, EPURCHASING

  // Data Kontrak
  nomor_kontrak     String?
  tanggal_kontrak   DateTime?
  jangka_waktu      Int?      // dalam hari kalender

  // Skema Pembayaran
  skema_pembayaran  String?   // SERATUS_PERSEN, TERMIN
  jumlah_termin     Int?      // Jumlah termin jika TERMIN

  // Status workflow
  status          String    @default("PERENCANAAN")  // PERENCANAAN, PERSIAPAN, PEMILIHAN, KONTRAK, PELAKSANAAN, SERAH_TERIMA, PEMBAYARAN, SELESAI

  created_at DateTime @default(now())
  created_by String?
  updated_at DateTime @updatedAt
  is_deleted Boolean  @default(false)

  // Relations
  satker          satker?             @relation(fields: [satker_id], references: [id])
  anggaran        anggaran?           @relation(fields: [anggaran_id], references: [id])
  penyedia        penyedia?           @relation(fields: [penyedia_id], references: [id])
  dokumen         dokumen[]
  permintaan      permintaan[]
  perjalanan      perjalanan_dinas[]
  transaksi       transaksi_keuangan[]
  dokumen_paket   dokumen_paket[]     // Dokumen workflow
  termin          termin_pembayaran[] // Termin pembayaran
  paket_anggaran  paket_anggaran[]    // Sumber anggaran (many-to-many)
  analisa_harga   analisa_harga_satuan[] // HPS: Analisa harga satuan
  boq             boq_item[]             // HPS: Bill of Quantities

  @@index([kode])
  @@index([tahun])
  @@index([satker_id])
  @@index([penyedia_id])
  @@index([status])
}

/// Paket Anggaran - Relasi many-to-many antara paket dan anggaran
/// Satu paket bisa mengambil dana dari beberapa detail anggaran
model paket_anggaran {
  id              String    @id @default(uuid())
  paket_id        String
  anggaran_id     String
  nilai_alokasi   Decimal   @default(0)  // Nilai yang dialokasikan dari anggaran ini

  created_at DateTime @default(now())
  is_deleted Boolean  @default(false)

  // Relations
  paket     paket    @relation(fields: [paket_id], references: [id], onDelete: Cascade)
  anggaran  anggaran @relation(fields: [anggaran_id], references: [id])

  @@unique([paket_id, anggaran_id])
  @@index([paket_id])
  @@index([anggaran_id])
}

/// Dokumen Paket - Dokumen per tahap workflow pengadaan
model dokumen_paket {
  id              String    @id @default(uuid())
  paket_id        String

  // Tahap workflow
  tahap           String    // PERENCANAAN, PERSIAPAN, PEMILIHAN, KONTRAK, PELAKSANAAN, SERAH_TERIMA, PEMBAYARAN

  // Jenis dokumen
  jenis           String    // KAK, SPESIFIKASI_TEKNIS, SURVEY_HARGA_1, SURVEY_HARGA_2, SURVEY_HARGA_3, BA_SURVEY_HARGA, HPS, UNDANGAN_PL, BA_NEGOSIASI, BAHPL, SPK, SPMK, LAPORAN_KEMAJUAN, BAHP, BAST, KUITANSI, BAP, SPP_LS, SPM_LS, CHECKLIST_LS

  nama            String    // Nama dokumen
  nomor           String?   // Nomor dokumen (jika ada)
  tanggal         DateTime? // Tanggal dokumen

  // File upload
  file_path       String?   // Path file yang diupload
  file_name       String?   // Nama file asli
  file_size       Int?      // Ukuran file dalam bytes
  file_type       String?   // MIME type (application/pdf, application/vnd.openxmlformats-officedocument.wordprocessingml.document)

  // Untuk termin (jika dokumen pembayaran termin)
  termin_ke       Int?      // Termin ke berapa (1, 2, 3, dst)

  // Status
  status          String    @default("DRAFT")  // DRAFT, UPLOADED, VERIFIED

  keterangan      String?

  created_at DateTime @default(now())
  created_by String?
  updated_at DateTime @updatedAt
  is_deleted Boolean  @default(false)

  // Relations
  paket           paket     @relation(fields: [paket_id], references: [id], onDelete: Cascade)

  @@index([paket_id])
  @@index([tahap])
  @@index([jenis])
  @@index([status])
}

/// Termin Pembayaran - Detail termin untuk paket
model termin_pembayaran {
  id              String    @id @default(uuid())
  paket_id        String

  termin_ke       Int       // Urutan termin (1, 2, 3, dst)
  persentase      Decimal   // Persentase dari nilai kontrak
  nilai           Decimal   // Nilai nominal
  keterangan      String?   // Keterangan termin

  // Status pembayaran
  status          String    @default("PENDING")  // PENDING, PROSES, LUNAS
  tanggal_bayar   DateTime? // Tanggal pembayaran aktual

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  is_deleted Boolean  @default(false)

  // Relations
  paket           paket     @relation(fields: [paket_id], references: [id], onDelete: Cascade)

  @@unique([paket_id, termin_ke])
  @@index([paket_id])
  @@index([status])
}

// =============================================================================
// 5. DOKUMEN UNIVERSAL (3 tables: dokumen, dokumen_versi, dokumen_pihak)
// =============================================================================

/// Dokumen - Semua jenis dokumen (generic)
model dokumen {
  id              String    @id @default(uuid())
  nomor           String
  paket_id        String?

  // Link ke perjalanan dinas (untuk SURAT_TUGAS, SPPD)
  perjalanan_id   String?

  // Tipe dokumen (discriminator)
  tipe            String    // Lihat enum DokumenTipe di bawah

  // Data umum
  judul           String?
  tanggal         DateTime  @default(now())
  status          String    @default("DRAFT")  // DRAFT, PROSES, FINAL, BATAL

  // Nilai (jika ada)
  nilai           Decimal?
  nilai_ppn       Decimal?
  nilai_pph       Decimal?
  nilai_final     Decimal?

  // Metadata spesifik per tipe (JSON)
  // Contoh KAK: {latar_belakang, maksud_tujuan, ruang_lingkup, spesifikasi}
  // Contoh Kontrak: {nama_penyedia, alamat, npwp, jangka_waktu}
  // Contoh SPP/SPM/SP2D: {jenis, rekening, bank}
  // Contoh Surat Tugas: {perihal, dasar}
  // Contoh SPPD: {instansi, mata_anggaran}
  metadata        String?   // JSON

  // File
  file_path       String?
  file_name       String?

  keterangan      String?

  created_at DateTime @default(now())
  created_by String?
  updated_at DateTime @updatedAt
  is_deleted Boolean  @default(false)

  // Relations
  paket         paket?            @relation(fields: [paket_id], references: [id])
  perjalanan    perjalanan_dinas? @relation(fields: [perjalanan_id], references: [id])
  versi         dokumen_versi[]
  pihak         dokumen_pihak[]   // Pihak terkait dengan proper FK

  @@index([nomor])
  @@index([paket_id])
  @@index([perjalanan_id])
  @@index([tipe])
  @@index([status])
  @@index([tanggal])
}

// Tipe Dokumen (untuk referensi):
// - PERENCANAAN: KAK, HPS, RAB
// - PEMILIHAN: UNDANGAN, PENAWARAN, EVALUASI, NEGOSIASI, PENETAPAN
// - KONTRAK: SPPBJ, KONTRAK, SPMK, ADENDUM
// - PELAKSANAAN: BA_KEMAJUAN, LAPORAN
// - SERAH_TERIMA: BAHP, BAST_SEMENTARA, BAST_AKHIR
// - PEMBAYARAN: SPP, SPM, SP2D, KUITANSI
// - PERJALANAN: SURAT_TUGAS, SPPD
// - LAINNYA: SURAT, MEMO, NODIN

/// Dokumen Versi - Riwayat versi dokumen
model dokumen_versi {
  id          String    @id @default(uuid())
  dokumen_id  String
  versi       Int

  file_path   String
  file_name   String
  file_size   BigInt?
  mime_type   String?
  checksum    String?   // SHA256

  // Tanda tangan (jika ada)
  signed_by   String?
  signed_date DateTime?
  signed_file String?

  catatan     String?
  is_current  Boolean   @default(false)

  created_at DateTime @default(now())
  created_by String?
  is_deleted Boolean  @default(false)

  dokumen dokumen @relation(fields: [dokumen_id], references: [id], onDelete: Cascade)

  @@unique([dokumen_id, versi])
  @@index([dokumen_id])
  @@index([is_current])
}

/// Dokumen Pihak - Relasi dokumen ke pegawai dengan proper FK
model dokumen_pihak {
  id          String    @id @default(uuid())
  dokumen_id  String
  pegawai_id  String

  // Peran dalam dokumen
  peran       String    // PEMBUAT, PEMERIKSA, PENANDATANGAN, PENERIMA, PENYETUJU

  // Jabatan saat menandatangani (snapshot)
  jabatan     String?

  // Urutan (jika ada beberapa penandatangan)
  urutan      Int       @default(0)

  // Status tanda tangan
  signed_at   DateTime?
  is_signed   Boolean   @default(false)

  catatan     String?

  created_at DateTime @default(now())
  is_deleted Boolean  @default(false)

  // Relations
  dokumen dokumen @relation(fields: [dokumen_id], references: [id], onDelete: Cascade)
  pegawai pegawai @relation(fields: [pegawai_id], references: [id])

  @@unique([dokumen_id, pegawai_id, peran])
  @@index([dokumen_id])
  @@index([pegawai_id])
  @@index([peran])
}

// =============================================================================
// 6. PERMINTAAN & SURVEY HARGA (3 tables: permintaan, item_permintaan, survey_harga)
// =============================================================================

/// Permintaan - Lembar permintaan barang/jasa
model permintaan {
  id              String    @id @default(uuid())
  nomor           String    @unique
  tanggal         DateTime  @default(now())
  paket_id        String?
  kepanitiaan_id  String?   // Link ke kepanitiaan

  // Pemohon
  pemohon_id      String?   // pegawai_id
  unit_pemohon    String?

  perihal         String
  tujuan          String?
  tanggal_butuh   DateTime?

  // Status
  status          String    @default("DRAFT")  // DRAFT, DIAJUKAN, DISETUJUI, DITOLAK, PROSES, SELESAI

  // Approval
  penyetuju_id    String?
  tanggal_setuju  DateTime?
  catatan_setuju  String?

  // Total nilai
  total_perkiraan Decimal   @default(0)
  total_hps       Decimal   @default(0)  // Rata-rata survey
  total_negosiasi Decimal   @default(0)
  total_kontrak   Decimal   @default(0)
  total_ppn       Decimal   @default(0)
  total_final     Decimal   @default(0)

  keterangan      String?

  created_at DateTime @default(now())
  created_by String?
  updated_at DateTime @updatedAt
  is_deleted Boolean  @default(false)

  // Relations
  paket       paket?       @relation(fields: [paket_id], references: [id])
  kepanitiaan kepanitiaan? @relation(fields: [kepanitiaan_id], references: [id])
  items       item_permintaan[]

  @@index([nomor])
  @@index([paket_id])
  @@index([kepanitiaan_id])
  @@index([status])
}

/// Item Permintaan - Detail barang/jasa
model item_permintaan {
  id              String  @id @default(uuid())
  permintaan_id   String
  urut            Int

  // Barang/Jasa
  jenis           String  @default("BARANG")  // BARANG, JASA
  nama            String
  spesifikasi     String?
  merk            String?

  // Quantity
  volume          Decimal @default(1)
  satuan          String  @default("Unit")

  // Harga bertahap
  harga_perkiraan Decimal @default(0)
  harga_hps       Decimal @default(0)  // Dari rata-rata survey
  harga_negosiasi Decimal @default(0)
  harga_kontrak   Decimal @default(0)
  ppn_persen      Decimal @default(11)
  ppn_nominal     Decimal @default(0)
  harga_final     Decimal @default(0)  // Kontrak + PPN

  // Total (harga x volume)
  total_perkiraan Decimal @default(0)
  total_hps       Decimal @default(0)
  total_negosiasi Decimal @default(0)
  total_kontrak   Decimal @default(0)
  total_ppn       Decimal @default(0)
  total_final     Decimal @default(0)

  keterangan      String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  is_deleted Boolean  @default(false)

  // Relations
  permintaan   permintaan     @relation(fields: [permintaan_id], references: [id], onDelete: Cascade)
  survey_harga survey_harga[]

  @@index([permintaan_id])
}

/// Survey Harga - Data survey (min 3)
model survey_harga {
  id              String   @id @default(uuid())
  item_id         String
  urut            Int      // 1, 2, 3, ...

  nama_sumber     String   // Nama toko/supplier
  alamat          String?
  kontak          String?

  harga           Decimal  @default(0)
  tanggal         DateTime @default(now())

  bukti_path      String?  // File bukti
  keterangan      String?
  is_valid        Boolean  @default(true)

  created_at DateTime @default(now())
  is_deleted Boolean  @default(false)

  item item_permintaan @relation(fields: [item_id], references: [id], onDelete: Cascade)

  @@index([item_id])
}

// =============================================================================
// 7. PERJALANAN DINAS (2 tables: perjalanan_dinas, peserta_dinas)
// =============================================================================

/// Perjalanan Dinas
model perjalanan_dinas {
  id              String    @id @default(uuid())
  nomor           String    @unique
  paket_id        String?

  // Surat Tugas
  nomor_surat_tugas    String?
  tanggal_surat_tugas  DateTime?

  maksud          String
  kota_asal       String
  kota_tujuan     String
  tanggal_pergi   DateTime
  tanggal_pulang  DateTime
  lama_hari       Int

  // Biaya
  estimasi_biaya  Decimal?
  realisasi_biaya Decimal?

  // Status
  status          String    @default("DRAFT")  // DRAFT, DIAJUKAN, DISETUJUI, BERLANGSUNG, SELESAI, BATAL

  catatan         String?

  created_at DateTime @default(now())
  created_by String?
  updated_at DateTime @updatedAt
  is_deleted Boolean  @default(false)

  // Relations
  paket    paket?          @relation(fields: [paket_id], references: [id])
  peserta  peserta_dinas[]
  dokumen  dokumen[]       // Surat Tugas, SPPD terkait

  @@index([nomor])
  @@index([paket_id])
  @@index([status])
}

/// Peserta Perjalanan Dinas
model peserta_dinas {
  id              String  @id @default(uuid())
  perjalanan_id   String
  pegawai_id      String

  tingkat_biaya   String?
  is_ketua        Boolean @default(false)

  // Biaya per orang
  uang_harian     Decimal?
  transport       Decimal?       // Transport total (untuk kompatibilitas)
  transport_udara Decimal?       // Transport pesawat
  transport_darat Decimal?       // Transport darat
  penginapan      Decimal?
  lainnya         Decimal?

  catatan         String?

  created_at DateTime @default(now())
  is_deleted Boolean  @default(false)

  perjalanan perjalanan_dinas @relation(fields: [perjalanan_id], references: [id], onDelete: Cascade)
  pegawai    pegawai          @relation(fields: [pegawai_id], references: [id])

  @@unique([perjalanan_id, pegawai_id])
  @@index([perjalanan_id])
  @@index([pegawai_id])
}

// =============================================================================
// 8. TRANSAKSI KEUANGAN (1 table: transaksi_keuangan)
// =============================================================================

/// Transaksi Keuangan - UP, TUP, Kuitansi, Pembayaran (unified)
model transaksi_keuangan {
  id              String    @id @default(uuid())
  nomor           String    @unique
  paket_id        String?

  // Tipe transaksi
  tipe            String    // UP, TUP, KUITANSI_UM, KUITANSI_RAMPUNG, OPERASIONAL

  tanggal         DateTime  @default(now())

  // Nilai
  nilai           Decimal   @default(0)
  sisa            Decimal   @default(0)

  // Untuk Kuitansi
  uraian          String?
  penerima        String?

  // Referensi (untuk kuitansi rampung ke UM, atau TUP ke UP)
  referensi_id    String?

  // Status
  status          String    @default("DRAFT")  // DRAFT, DIAJUKAN, VERIFIKASI, BAYAR, SELESAI, TOLAK

  // Metadata tambahan (JSON)
  metadata        String?

  keterangan      String?

  created_at DateTime @default(now())
  created_by String?
  updated_at DateTime @updatedAt
  is_deleted Boolean  @default(false)

  // Relations
  paket           paket?               @relation(fields: [paket_id], references: [id])
  referensi       transaksi_keuangan?  @relation("TransaksiRef", fields: [referensi_id], references: [id])
  referensi_child transaksi_keuangan[] @relation("TransaksiRef")

  @@index([nomor])
  @@index([paket_id])
  @@index([tipe])
  @@index([status])
}

// =============================================================================
// 9. AUDIT & LOG (2 tables: approval_log, audit_log)
// =============================================================================

/// Approval Log - Riwayat persetujuan
model approval_log {
  id          String    @id @default(uuid())

  // Target approval (polymorphic)
  entity_type String    // dokumen, permintaan, perjalanan, transaksi
  entity_id   String

  // Approver
  approver_id String?
  role_code   String?

  // Status
  status      String    // PENDING, APPROVED, REJECTED, REVISI
  catatan     String?

  approved_at DateTime?

  created_at DateTime @default(now())

  @@index([entity_type, entity_id])
  @@index([approver_id])
  @@index([status])
}

/// Audit Log - Jejak audit (immutable)
model audit_log {
  id          String   @id @default(uuid())

  table_name  String
  record_id   String
  action      String   // INSERT, UPDATE, DELETE

  old_values  String?  // JSON
  new_values  String?  // JSON

  actor_id    String?
  ip_address  String?
  user_agent  String?

  created_at DateTime @default(now())

  @@index([table_name, record_id])
  @@index([actor_id])
  @@index([created_at])
}

// =============================================================================
// 10. STANDAR BIAYA MASUKAN (SBM)
// =============================================================================

/// SBM Uang Harian - Tarif uang harian perjalanan dinas
model sbm_uang_harian {
  id              String  @id @default(uuid())
  tahun           Int     // Tahun anggaran
  provinsi        String  // Nama provinsi
  kode_provinsi   String? // Kode provinsi (opsional)

  // Tarif berdasarkan lama perjalanan
  luar_kota       Decimal @default(0) // Perjalanan dinas luar kota (lebih dari 8 jam)
  dalam_kota      Decimal @default(0) // Perjalanan dinas dalam kota (lebih dari 8 jam)
  diklat          Decimal @default(0) // Perjalanan dinas untuk diklat/pelatihan

  keterangan      String?
  is_active       Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  is_deleted Boolean  @default(false)

  @@unique([tahun, provinsi])
  @@index([tahun])
  @@index([provinsi])
}

/// SBM Penginapan - Tarif penginapan perjalanan dinas
model sbm_penginapan {
  id              String  @id @default(uuid())
  tahun           Int     // Tahun anggaran
  provinsi        String  // Nama provinsi
  kode_provinsi   String? // Kode provinsi (opsional)

  // Tarif berdasarkan eselon/golongan
  eselon_1        Decimal @default(0) // Pejabat Eselon I
  eselon_2        Decimal @default(0) // Pejabat Eselon II
  eselon_3        Decimal @default(0) // Pejabat Eselon III
  eselon_4        Decimal @default(0) // Pejabat Eselon IV
  golongan_4      Decimal @default(0) // Golongan IV (non-eselon)
  golongan_3      Decimal @default(0) // Golongan III
  golongan_2      Decimal @default(0) // Golongan II
  golongan_1      Decimal @default(0) // Golongan I

  keterangan      String?
  is_active       Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  is_deleted Boolean  @default(false)

  @@unique([tahun, provinsi])
  @@index([tahun])
  @@index([provinsi])
}

/// SBM Honor - Tarif honorarium
model sbm_honor {
  id              String  @id @default(uuid())
  tahun           Int     // Tahun anggaran
  kode            String  // Kode honor (misal: NARASUMBER, MODERATOR, dll)
  nama            String  // Nama jenis honor
  kategori        String? // Kategori (NARASUMBER, PANITIA, TIM_KERJA, dll)

  // Tarif berdasarkan tingkatan
  tarif_1         Decimal @default(0) // Tarif tingkat 1 (tertinggi)
  tarif_2         Decimal @default(0) // Tarif tingkat 2
  tarif_3         Decimal @default(0) // Tarif tingkat 3
  tarif_4         Decimal @default(0) // Tarif tingkat 4 (terendah)

  satuan          String? // Satuan (OJ, OK, OH, Orang, dll)
  keterangan      String?
  is_active       Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  is_deleted Boolean  @default(false)

  @@unique([tahun, kode])
  @@index([tahun])
  @@index([kode])
  @@index([kategori])
}

/// SBM Transport - Tarif transportasi
model sbm_transport {
  id              String  @id @default(uuid())
  tahun           Int     // Tahun anggaran
  asal            String  // Kota asal
  tujuan          String  // Kota tujuan
  jenis           String  // PESAWAT, KAPAL, KERETA, BIS

  tarif           Decimal @default(0)

  keterangan      String?
  is_active       Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  is_deleted Boolean  @default(false)

  @@unique([tahun, asal, tujuan, jenis])
  @@index([tahun])
  @@index([asal])
  @@index([tujuan])
}

// =============================================================================
// 11. KEPANITIAAN (Committee Management)
// =============================================================================

/// Kepanitiaan - Data Panitia/Tim Kerja
model kepanitiaan {
  id              String    @id @default(uuid())
  nomor_sk        String    @unique  // Nomor SK Panitia
  tanggal_sk      DateTime  // Tanggal SK
  nama_kegiatan   String    // Nama Kegiatan/Panitia
  jenis_panitia   String    // PENGADAAN, PEMERIKSA, PENERIMA, TIM_KERJA, dll

  // Periode Aktif
  tanggal_mulai   DateTime?
  tanggal_selesai DateTime?

  // Link ke Paket (opsional)
  paket_id        String?

  // Anggaran
  anggaran_id     String?   // Link ke anggaran (MAK)
  total_honor     Decimal   @default(0)

  // Status
  status          String    @default("DRAFT")  // DRAFT, AKTIF, SELESAI, BATAL

  keterangan      String?

  created_at DateTime @default(now())
  created_by String?
  updated_at DateTime @updatedAt
  is_deleted Boolean  @default(false)

  // Relations
  anggota    anggota_panitia[]
  permintaan permintaan[]

  @@index([nomor_sk])
  @@index([jenis_panitia])
  @@index([status])
  @@index([tanggal_sk])
}

/// Anggota Panitia - Detail anggota panitia
model anggota_panitia {
  id              String    @id @default(uuid())
  kepanitiaan_id  String
  pegawai_id      String?   // Link ke pegawai (opsional, bisa anggota luar)

  // Data anggota (jika bukan pegawai internal)
  nama            String
  nip             String?
  jabatan         String?   // Jabatan di instansi
  golongan        String?

  // Peran dalam panitia
  peran           String    // KETUA, SEKRETARIS, ANGGOTA, dll
  urutan          Int       @default(0)

  // Honorarium
  honor_per_kegiatan Decimal @default(0)
  jumlah_kegiatan    Int     @default(1)
  total_honor        Decimal @default(0)

  keterangan      String?

  created_at DateTime @default(now())
  is_deleted Boolean  @default(false)

  // Relations
  kepanitiaan kepanitiaan @relation(fields: [kepanitiaan_id], references: [id], onDelete: Cascade)

  @@index([kepanitiaan_id])
  @@index([pegawai_id])
  @@index([peran])
}

// =============================================================================
// 12. HONORARIUM BULANAN
// =============================================================================

/// Honorarium - Pembayaran Honorarium Bulanan
model honorarium {
  id              String    @id @default(uuid())
  nomor           String    @unique
  bulan           Int       // 1-12
  tahun           Int

  jenis           String    // NARASUMBER, MODERATOR, PANITIA, TIM_KERJA, dll
  kepanitiaan_id  String?   // Link ke kepanitiaan (opsional)

  total_kotor     Decimal   @default(0)
  total_pph21     Decimal   @default(0)
  total_bersih    Decimal   @default(0)

  status          String    @default("DRAFT")  // DRAFT, DIAJUKAN, DISETUJUI, DIBAYAR
  keterangan      String?

  created_at DateTime @default(now())
  created_by String?
  updated_at DateTime @updatedAt
  is_deleted Boolean  @default(false)

  // Relations
  details    detail_honorarium[]

  @@index([nomor])
  @@index([bulan, tahun])
  @@index([jenis])
  @@index([status])
}

/// Detail Honorarium - Penerima honorarium
model detail_honorarium {
  id              String    @id @default(uuid())
  honorarium_id   String
  pegawai_id      String?

  nama            String
  nip             String?
  jabatan         String?
  golongan        String?

  jenis_honor     String    // Jenis honor
  tarif           Decimal   @default(0)
  volume          Int       @default(1)
  satuan          String    @default("OK")  // OK, OJ, OH, OB

  jumlah_kotor    Decimal   @default(0)
  pph21           Decimal   @default(0)
  jumlah_bersih   Decimal   @default(0)

  keterangan      String?

  created_at DateTime @default(now())
  is_deleted Boolean  @default(false)

  // Relations
  honorarium honorarium @relation(fields: [honorarium_id], references: [id], onDelete: Cascade)

  @@index([honorarium_id])
  @@index([pegawai_id])
}

// =============================================================================
// 13. MONITORING SP2D
// =============================================================================

/// Monitoring SP2D - Data SPP, SPM, dan SP2D dari KPPN
model monitoring_sp2d {
  id                  String    @id @default(uuid())

  // Data KPPN & Satker
  kppn                String?   // Nama KPPN
  kode_satker         String?   // Kode Satker
  nama_satker         String?   // Nama Satker

  // Data SPP/SPM
  no_spp_spm          String?   // Nomor SPP/SPM
  jenis_spp_spm       String?   // Jenis SPP/SPM (LS-BANYAK PENERIMA, GAJI, UP, dll)
  status_spp_spm      String?   // Status SPP/SPM (Baru, Upload SP2D)
  tanggal_spp         DateTime? // Tanggal SPP
  tanggal_spm         DateTime? // Tanggal SPM
  tanggal_rpd_harian  DateTime? // Tanggal RPD Harian

  // Data SP2D
  tanggal_sp2d        DateTime? // Tanggal SP2D
  no_sp2d             String?   // Nomor SP2D
  status_sp2d         String?   // Status SP2D (Terbit SP2D, Sudah Dikonfirmasi Bank, dll)

  // Nilai
  jumlah_pengeluaran  Decimal   @default(0) // Jumlah Pengeluaran
  jumlah_potongan     Decimal   @default(0) // Jumlah Potongan
  jumlah_pembayaran   Decimal   @default(0) // Jumlah Pembayaran (Pengeluaran - Potongan)

  // Uraian & Pejabat
  uraian              String?   // Uraian SPP/SPM
  ppk_nama            String?   // Nama PPK
  ppk_nip             String?   // NIP PPK
  ppspm_nama          String?   // Nama PPSPM
  ppspm_nip           String?   // NIP PPSPM

  // Data Koreksi
  spm_koreksi         Boolean   @default(false) // SPM Koreksi?
  jenis_spm_koreksi   String?   // Jenis SPM Koreksi
  jumlah_penerima_retur Int?    // Jumlah Penerima Retur

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  is_deleted Boolean  @default(false)

  @@index([kode_satker])
  @@index([no_spp_spm])
  @@index([no_sp2d])
  @@index([status_spp_spm])
  @@index([status_sp2d])
  @@index([tanggal_sp2d])
  @@index([jenis_spp_spm])
}

// =============================================================================
// 14. TARUNA (Mahasiswa Politeknik KP)
// =============================================================================

/// Taruna - Data Taruna/Mahasiswa
model taruna {
  id              String    @id @default(uuid())
  nim             String    @unique
  nit             String?   // Nomor Induk Taruna
  nama            String
  tempat_lahir    String?
  tanggal_lahir   DateTime?
  jenis_kelamin   String?   // L/P
  program_studi   String?   // NAUTIKA, TEKNIKA, TPLP, dll
  angkatan        Int?      // Tahun masuk (2022, 2023, dst)
  semester        Int?
  kelas           String?
  telepon         String?
  email           String?
  alamat          String?
  nama_ortu       String?
  no_rekening     String?
  nama_bank       String?
  status          String    @default("AKTIF")  // AKTIF, CUTI, LULUS, DO
  is_active       Boolean   @default(true)
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  is_deleted      Boolean   @default(false)

  // Relations
  detail_sk       detail_sk[]

  @@index([nim])
  @@index([nit])
  @@index([program_studi])
  @@index([angkatan])
  @@index([status])
}

// =============================================================================
// 15. SURAT KEPUTUSAN (SK)
// =============================================================================

/// Surat Keputusan - SK Pengelola Keuangan, Honor Kegiatan, Taruna
model surat_keputusan {
  id              String    @id @default(uuid())
  nomor_sk        String    @unique
  tanggal_sk      DateTime
  jenis           String    // PENGELOLA_KEUANGAN, HONOR_KEGIATAN, TARUNA
  judul           String?   // Judul/perihal SK

  // Periode berlaku
  bulan           Int?      // Untuk SK bulanan (pengelola, taruna)
  tahun           Int

  // Referensi anggaran
  anggaran_id     String?

  // Dasar hukum (JSON array of strings)
  dasar_hukum     String?   // JSON: ["UU No...", "PMK No..."]

  // Penandatangan
  penandatangan_nama    String?
  penandatangan_nip     String?
  penandatangan_jabatan String?  // biasanya KPA

  // Totals (calculated)
  total_kotor     Decimal   @default(0)
  total_pph       Decimal   @default(0)
  total_bersih    Decimal   @default(0)

  status          String    @default("DRAFT")  // DRAFT, AKTIF, SELESAI, BATAL

  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  is_deleted      Boolean   @default(false)

  // Relations
  anggaran        anggaran?   @relation(fields: [anggaran_id], references: [id])
  details         detail_sk[]

  @@index([jenis])
  @@index([tahun])
  @@index([status])
}

/// Detail SK - Penerima/detail per SK
model detail_sk {
  id              String    @id @default(uuid())
  sk_id           String
  urutan          Int       @default(0)

  // Penerima (bisa pegawai atau taruna)
  pegawai_id      String?
  taruna_id       String?
  nama            String
  nip             String?   // NIP untuk pegawai
  nim             String?   // NIM untuk taruna

  // Jabatan/peran dalam SK
  jabatan         String?   // KPA, PPK, PPSPM, BENDAHARA, STAF, NARASUMBER, dll
  golongan        String?

  // Kalkulasi
  tarif           Decimal   @default(0)
  volume          Int       @default(1)
  satuan          String?   // Bulan, OJ, Keg, dll
  jumlah_kotor    Decimal   @default(0)
  pph             Decimal   @default(0)
  jumlah_bersih   Decimal   @default(0)

  // Data tambahan
  npwp            String?
  no_rekening     String?
  nama_bank       String?
  keterangan      String?

  created_at      DateTime  @default(now())
  is_deleted      Boolean   @default(false)

  // Relations
  surat_keputusan surat_keputusan @relation(fields: [sk_id], references: [id], onDelete: Cascade)
  pegawai         pegawai?        @relation(fields: [pegawai_id], references: [id])
  taruna          taruna?         @relation(fields: [taruna_id], references: [id])

  @@index([sk_id])
  @@index([pegawai_id])
  @@index([taruna_id])
}

// ==================== HPS KONSTRUKSI ====================

// Master Harga Satuan (Bahan, Upah, Alat) dari Perwali
model harga_satuan {
  id        String   @id @default(uuid())
  kode      String                         // II.23.141, II.24.15, dll
  uraian    String                         // "Serat semen/grc 4mm", "Pekerja"
  jenis     String                         // BAHAN, UPAH, ALAT
  satuan    String                         // kg, Lbr, hr, m1, m2, m3, dll
  harga     Decimal  @default(0)
  tahun     Int                            // 2025, 2026
  sumber    String?                        // "Perwali Kota Sorong No 15/2024"

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  is_deleted Boolean  @default(false)

  analisa_details analisa_detail[]

  @@index([jenis, tahun])
  @@index([kode])
}

// Analisa Harga Satuan per item pekerjaan per paket
model analisa_harga_satuan {
  id              String   @id @default(uuid())
  paket_id        String
  kode_analisa    String?                  // A.1.6.12, A.4.5.2.40.1
  nama_pekerjaan  String                   // "Pek. Pemasangan 1 m2 Langit-langit..."
  satuan          String                   // m2, m1, dll
  overhead_persen Decimal  @default(10)    // 10-15%

  // Computed totals (disimpan untuk performa)
  total_tenaga    Decimal  @default(0)
  total_bahan     Decimal  @default(0)
  total_alat      Decimal  @default(0)
  total_dasar     Decimal  @default(0)     // A+B+C
  total_overhead  Decimal  @default(0)     // overhead % x total_dasar
  harga_satuan    Decimal  @default(0)     // total_dasar + total_overhead

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  is_deleted Boolean  @default(false)

  paket   paket            @relation(fields: [paket_id], references: [id])
  details analisa_detail[]
  boq_items boq_item[]
}

// Detail komponen analisa (tenaga kerja, bahan, alat)
model analisa_detail {
  id              String   @id @default(uuid())
  analisa_id      String
  kelompok        String                   // TENAGA_KERJA, BAHAN, PERALATAN
  harga_satuan_id String?                  // FK ke master (nullable jika manual)
  uraian          String
  kode            String?
  satuan          String
  koefisien       Decimal  @default(0)
  harga           Decimal  @default(0)     // harga per satuan
  jumlah_harga    Decimal  @default(0)     // koefisien x harga

  created_at DateTime @default(now())
  is_deleted Boolean  @default(false)

  analisa       analisa_harga_satuan @relation(fields: [analisa_id], references: [id])
  master_harga  harga_satuan?        @relation(fields: [harga_satuan_id], references: [id])
}

// BOQ (Bill of Quantities) per paket
model boq_item {
  id                String   @id @default(uuid())
  paket_id          String
  nomor             Int                    // Urutan: 1, 2, 3...
  kelompok          String   @default("A") // Group: A, B, C...
  uraian_pekerjaan  String
  kode_analisa      String?
  analisa_id        String?                // FK ke analisa
  volume            Decimal  @default(0)
  satuan            String
  harga_satuan      Decimal  @default(0)   // dari analisa atau manual
  jumlah_harga      Decimal  @default(0)   // volume x harga_satuan

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  is_deleted Boolean  @default(false)

  paket   paket                 @relation(fields: [paket_id], references: [id])
  analisa analisa_harga_satuan? @relation(fields: [analisa_id], references: [id])
}

// Riwayat import realisasi dari Laporan FA Detail
model realisasi_import {
  id              String   @id @default(uuid())
  tahun           Int
  periode         String   // e.g. "Februari 2026"
  nama_file       String
  jumlah_mak      Int      @default(0)
  matched         Int      @default(0)
  unmatched       Int      @default(0)
  total_pagu      Decimal  @default(0)
  total_realisasi Decimal  @default(0)
  created_at      DateTime @default(now())
}
