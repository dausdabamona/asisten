/// Table 15: Perjalanan Dinas - Business trip (Phase 2 Enhanced)
model perjalanan_dinas {
  id                   String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  nomor                String           @unique @db.VarChar(100)
  paket_id             String?          @db.Uuid
  workflow_instance_id String?          @db.Uuid  // Phase 2: Link to workflow
  maksud_perjalanan    String           @db.Text
  kota_asal            String           @db.VarChar(255)
  kota_tujuan          String           @db.VarChar(255)
  tanggal_berangkat    DateTime
  tanggal_kembali      DateTime
  lama_hari            Int
  status               PerjalananStatus @default(DRAFT)
  catatan              String?          @db.Text
  // Phase 2: Financial summary
  total_biaya_estimasi Decimal?         @db.Decimal(18, 2)
  total_biaya_realisasi Decimal?        @db.Decimal(18, 2)

  // Standard audit fields
  created_at DateTime @default(now())
  created_by String?  @db.Uuid
  updated_at DateTime @updatedAt
  updated_by String?  @db.Uuid
  is_deleted Boolean  @default(false)

  // Relations
  paket              paket?               @relation(fields: [paket_id], references: [id])
  workflow_instance  workflow_instance?   @relation(fields: [workflow_instance_id], references: [id])
  creator            users?               @relation("PerjalananCreatedBy", fields: [created_by], references: [id])
  updater            users?               @relation("PerjalananUpdatedBy", fields: [updated_by], references: [id])
  peserta            peserta_perjalanan[]
  surat_tugas        surat_tugas?         // Phase 2: One perjalanan must have exactly one surat_tugas
  sppd               sppd[]
  kuitansi           kuitansi[]           // Phase 2: Link kuitansi to perjalanan
  pertanggungjawaban pertanggungjawaban[]

  @@index([paket_id])
  @@index([workflow_instance_id])
  @@index([tanggal_berangkat])
  @@index([tanggal_kembali])
  @@index([status])
  @@index([is_deleted])
  @@schema("asisten")
}

/// Table 16: Peserta Perjalanan - Trip participants
model peserta_perjalanan {
  id                  String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  perjalanan_dinas_id String   @db.Uuid
  user_id             String   @db.Uuid
  tingkat_biaya       String?  @db.VarChar(50)
  golongan            String?  @db.VarChar(20)
  jabatan_perjalanan  String?  @db.VarChar(255)
  is_ketua            Boolean  @default(false)
  catatan             String?  @db.Text
  // Phase 2: Individual cost tracking
  uang_harian         Decimal? @db.Decimal(18, 2)
  biaya_transport     Decimal? @db.Decimal(18, 2)
  biaya_penginapan    Decimal? @db.Decimal(18, 2)
  biaya_lainnya       Decimal? @db.Decimal(18, 2)

  // Standard audit fields
  created_at DateTime @default(now())
  created_by String?  @db.Uuid
  updated_at DateTime @updatedAt
  updated_by String?  @db.Uuid
  is_deleted Boolean  @default(false)

  // Relations
  perjalanan_dinas perjalanan_dinas @relation(fields: [perjalanan_dinas_id], references: [id], onDelete: Cascade)
  user             users            @relation(fields: [user_id], references: [id])

  @@unique([perjalanan_dinas_id, user_id])
  @@index([perjalanan_dinas_id])
  @@index([user_id])
  @@index([is_deleted])
  @@schema("asisten")
}

/// Table 17: Surat Tugas - Assignment letter (Phase 2 Enhanced)
model surat_tugas {
  id                   String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  nomor                String           @unique @db.VarChar(100)
  perjalanan_dinas_id  String           @unique @db.Uuid  // Phase 2: UNIQUE - One perjalanan has exactly one ST
  dokumen_id           String?          @db.Uuid  // Phase 2: Link to dokumen engine
  tanggal_surat        DateTime
  perihal              String           @db.Text
  dasar                String?          @db.Text
  penanda_tangan_id    String?          @db.Uuid
  jabatan_penanda      String?          @db.VarChar(255)
  file_path            String?          @db.VarChar(1000)
  status               SuratTugasStatus @default(DRAFT)  // Phase 2

  // Standard audit fields
  created_at DateTime @default(now())
  created_by String?  @db.Uuid
  updated_at DateTime @updatedAt
  updated_by String?  @db.Uuid
  is_deleted Boolean  @default(false)

  // Relations
  perjalanan_dinas perjalanan_dinas @relation(fields: [perjalanan_dinas_id], references: [id], onDelete: Cascade)
  dokumen          dokumen?         @relation(fields: [dokumen_id], references: [id])
  penanda_tangan   users?           @relation("SuratTugasPenandaTangan", fields: [penanda_tangan_id], references: [id])
  creator          users?           @relation("SuratTugasCreatedBy", fields: [created_by], references: [id])
  updater          users?           @relation("SuratTugasUpdatedBy", fields: [updated_by], references: [id])

  @@index([perjalanan_dinas_id])
  @@index([dokumen_id])
  @@index([tanggal_surat])
  @@index([status])
  @@index([is_deleted])
  @@schema("asisten")
}

/// Table 18: SPPD - Surat Perintah Perjalanan Dinas (Phase 2 Enhanced)
model sppd {
  id                  String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  nomor               String     @unique @db.VarChar(100)
  perjalanan_dinas_id String     @db.Uuid
