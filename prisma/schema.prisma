  dokumen dokumen? @relation(fields: [dokumen_id], references: [id])
  kontrak kontrak[]

  @@index([hps_id])
  @@index([dokumen_id])
  @@index([tanggal_draft])
  @@index([is_deleted])
  @@schema("asisten")
}

/// Table 26: Kontrak - Contract
model kontrak {
  id                   String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  nomor                String        @unique @db.VarChar(100)
  paket_id             String        @db.Uuid
  rancangan_kontrak_id String?       @db.Uuid
  dokumen_id           String?       @db.Uuid
  judul                String        @db.VarChar(500)
  nama_penyedia        String        @db.VarChar(255)
  alamat_penyedia      String?       @db.Text
  npwp_penyedia        String?       @db.VarChar(30)
  nilai_kontrak        Decimal       @db.Decimal(18, 2)
  nilai_ppn            Decimal?      @db.Decimal(18, 2)
  nilai_pph            Decimal?      @db.Decimal(18, 2)
  tanggal_kontrak      DateTime
  tanggal_mulai        DateTime?
  tanggal_selesai      DateTime?
  jangka_waktu         Int?          // Duration in days
  ppk_id               String?       @db.Uuid
  status               KontrakStatus @default(DRAFT)
  catatan              String?       @db.Text

  // Standard audit fields
  created_at DateTime @default(now())
  created_by String?  @db.Uuid
  updated_at DateTime @updatedAt
  updated_by String?  @db.Uuid
  is_deleted Boolean  @default(false)

  // Relations
  paket             paket              @relation(fields: [paket_id], references: [id], onDelete: Cascade)
  rancangan_kontrak rancangan_kontrak? @relation(fields: [rancangan_kontrak_id], references: [id])
  dokumen           dokumen?           @relation(fields: [dokumen_id], references: [id])
  ppk               users?             @relation("KontrakPPK", fields: [ppk_id], references: [id])
  creator           users?             @relation("KontrakCreatedBy", fields: [created_by], references: [id])
  updater           users?             @relation("KontrakUpdatedBy", fields: [updated_by], references: [id])
  ssuk              ssuk[]
  sskk              sskk[]
  spmk              spmk[]
  adendum_kontrak   adendum_kontrak[]
  ba_kemajuan       ba_kemajuan[]
  bahp              bahp[]
  bast              bast[]
  spp               spp[]
  rekening_penyedia rekening_penyedia[]

  @@index([paket_id])
  @@index([rancangan_kontrak_id])
  @@index([dokumen_id])
  @@index([status])
  @@index([tanggal_kontrak])
  @@index([is_deleted])
  @@schema("asisten")
}

