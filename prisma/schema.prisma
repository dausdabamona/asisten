  dokumen          dokumen?           @relation(fields: [dokumen_id], references: [id])
  penyusun         users?             @relation("HPSPenyusun", fields: [penyusun_id], references: [id])
  creator          users?             @relation("HPSCreatedBy", fields: [created_by], references: [id])
  updater          users?             @relation("HPSUpdatedBy", fields: [updated_by], references: [id])
  rancangan_kontrak rancangan_kontrak[]

  @@index([paket_id])
  @@index([kak_id])
  @@index([dokumen_id])
  @@index([status])
  @@index([tanggal_hps])
  @@index([is_deleted])
  @@schema("asisten")
}

/// Table 25: Rancangan Kontrak - Draft Contract
model rancangan_kontrak {
  id              String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  nomor           String   @unique @db.VarChar(100)
  hps_id          String   @db.Uuid
  dokumen_id      String?  @db.Uuid
  judul           String   @db.VarChar(500)
  isi_kontrak     String?  @db.Text
  nilai_kontrak   Decimal  @db.Decimal(18, 2)
  jangka_waktu    Int?     // Duration in days
  tanggal_draft   DateTime
  catatan         String?  @db.Text

  // Standard audit fields
  created_at DateTime @default(now())
  created_by String?  @db.Uuid
  updated_at DateTime @updatedAt
  updated_by String?  @db.Uuid
  is_deleted Boolean  @default(false)

  // Relations
