/// Table 34: SPP - Surat Permintaan Pembayaran (Payment Request)
model spp {
  id              String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  nomor           String    @unique @db.VarChar(100)
  paket_id        String    @db.Uuid
  kontrak_id      String?   @db.Uuid
  bast_id         String?   @db.Uuid  // SPP requires final BAST
  dokumen_id      String?   @db.Uuid
  tanggal_spp     DateTime
  jenis_spp       String    @db.VarChar(50)  // LS (Langsung), UP, TUP, GUP
  nilai_tagihan   Decimal   @db.Decimal(18, 2)
  nilai_ppn       Decimal?  @db.Decimal(18, 2)
  nilai_pph       Decimal?  @db.Decimal(18, 2)
  nilai_potongan  Decimal?  @db.Decimal(18, 2)
  nilai_bersih    Decimal   @db.Decimal(18, 2)
  ppk_id          String?   @db.Uuid
  status          SPPStatus @default(DRAFT)
  catatan         String?   @db.Text

  // Standard audit fields
  created_at DateTime @default(now())
  created_by String?  @db.Uuid
  updated_at DateTime @updatedAt
  updated_by String?  @db.Uuid
  is_deleted Boolean  @default(false)

  // Relations
  paket         paket        @relation(fields: [paket_id], references: [id], onDelete: Cascade)
  kontrak       kontrak?     @relation(fields: [kontrak_id], references: [id])
  bast          bast?        @relation(fields: [bast_id], references: [id])
  dokumen       dokumen?     @relation(fields: [dokumen_id], references: [id])
  ppk           users?       @relation("SPPPejabatPPK", fields: [ppk_id], references: [id])
  creator       users?       @relation("SPPCreatedBy", fields: [created_by], references: [id])
  updater       users?       @relation("SPPUpdatedBy", fields: [updated_by], references: [id])
  spp_detail    spp_detail[]
  spm           spm[]
  potongan_pajak potongan_pajak[]

  @@index([paket_id])
  @@index([kontrak_id])
  @@index([bast_id])
  @@index([dokumen_id])
  @@index([status])
  @@index([tanggal_spp])
  @@index([is_deleted])
  @@schema("asisten")
}

/// Table 35: SPP Detail - Payment Request Line Items
model spp_detail {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  spp_id        String   @db.Uuid
  urutan        Int
  uraian        String   @db.Text
  volume        Decimal? @db.Decimal(18, 4)
  satuan        String?  @db.VarChar(50)
  harga_satuan  Decimal? @db.Decimal(18, 2)
  jumlah        Decimal  @db.Decimal(18, 2)

  // Standard audit fields
  created_at DateTime @default(now())
  created_by String?  @db.Uuid
  updated_at DateTime @updatedAt
  updated_by String?  @db.Uuid
  is_deleted Boolean  @default(false)

  // Relations
  spp spp @relation(fields: [spp_id], references: [id], onDelete: Cascade)

  @@index([spp_id])
  @@index([is_deleted])
  @@schema("asisten")
}

/// Table 36: SPM - Surat Perintah Membayar (Payment Order)
model spm {
  id             String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  nomor          String    @unique @db.VarChar(100)
  paket_id       String    @db.Uuid
  spp_id         String    @db.Uuid  // SPM requires approved SPP
  dokumen_id     String?   @db.Uuid
  tanggal_spm    DateTime
  jenis_spm      String    @db.VarChar(50)  // Same as SPP type
  nilai_spm      Decimal   @db.Decimal(18, 2)
  kuasa_pa_id    String?   @db.Uuid  // Kuasa Pengguna Anggaran
  status         SPMStatus @default(DRAFT)
  catatan        String?   @db.Text

  // Standard audit fields
  created_at DateTime @default(now())
  created_by String?  @db.Uuid
  updated_at DateTime @updatedAt
  updated_by String?  @db.Uuid
  is_deleted Boolean  @default(false)

  // Relations
  paket    paket    @relation(fields: [paket_id], references: [id], onDelete: Cascade)
  spp      spp      @relation(fields: [spp_id], references: [id])
  dokumen  dokumen? @relation(fields: [dokumen_id], references: [id])
  kuasa_pa users?   @relation("SPMKuasaPA", fields: [kuasa_pa_id], references: [id])
  creator  users?   @relation("SPMCreatedBy", fields: [created_by], references: [id])
  updater  users?   @relation("SPMUpdatedBy", fields: [updated_by], references: [id])
  sp2d     sp2d[]

  @@index([paket_id])
  @@index([spp_id])
  @@index([dokumen_id])
  @@index([status])
  @@index([tanggal_spm])
  @@index([is_deleted])
  @@schema("asisten")
}

/// Table 37: SP2D - Surat Perintah Pencairan Dana (Disbursement Order)
model sp2d {
  id                String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  nomor             String     @unique @db.VarChar(100)
  paket_id          String     @db.Uuid
  spm_id            String     @db.Uuid  // SP2D requires SPM
  dokumen_id        String?    @db.Uuid
  tanggal_sp2d      DateTime
  nilai_sp2d        Decimal    @db.Decimal(18, 2)
  bank_penerima     String?    @db.VarChar(100)
  rekening_penerima String?    @db.VarChar(50)
  nama_penerima     String?    @db.VarChar(255)
  kuasa_bud_id      String?    @db.Uuid  // Kuasa Bendahara Umum Daerah
  tanggal_cair      DateTime?
  status            SP2DStatus @default(DRAFT)
  catatan           String?    @db.Text

  // Standard audit fields
  created_at DateTime @default(now())
  created_by String?  @db.Uuid
  updated_at DateTime @updatedAt
  updated_by String?  @db.Uuid
  is_deleted Boolean  @default(false)

  // Relations
  paket     paket    @relation(fields: [paket_id], references: [id], onDelete: Cascade)
  spm       spm      @relation(fields: [spm_id], references: [id])
  dokumen   dokumen? @relation(fields: [dokumen_id], references: [id])
  kuasa_bud users?   @relation("SP2DKuasaBUD", fields: [kuasa_bud_id], references: [id])
  creator   users?   @relation("SP2DCreatedBy", fields: [created_by], references: [id])
  updater   users?   @relation("SP2DUpdatedBy", fields: [updated_by], references: [id])

  @@index([paket_id])
  @@index([spm_id])
  @@index([dokumen_id])
  @@index([status])
  @@index([tanggal_sp2d])
  @@index([is_deleted])
  @@schema("asisten")
}

/// Table 38: Potongan Pajak - Tax Deductions
model potongan_pajak {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  spp_id       String   @db.Uuid
  jenis_pajak  String   @db.VarChar(50)  // PPh21, PPh22, PPh23, PPN, etc.
