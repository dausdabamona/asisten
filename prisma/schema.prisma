  updater            users?               @relation("UPUpdatedBy", fields: [updated_by], references: [id])
  kuitansi           kuitansi[]
  pertanggungjawaban pertanggungjawaban[]
  tambahan_up        tambahan_uang_persediaan[]  // Phase 2: Link TUP to base UP

  @@index([paket_id])
  @@index([tanggal])
  @@index([status])
  @@index([treasury_type])
  @@index([is_deleted])
  @@schema("asisten")
}

/// Table 20: Tambahan Uang Persediaan (TUP) - Phase 2 New Table
model tambahan_uang_persediaan {
  id                  String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  nomor               String           @unique @db.VarChar(100)
  uang_persediaan_id  String           @db.Uuid  // Reference to base UP
  paket_id            String?          @db.Uuid
  tanggal             DateTime
  nilai               Decimal          @db.Decimal(18, 2)
  sisa                Decimal          @db.Decimal(18, 2)
  alasan              String           @db.Text  // Justification for additional funds
  bendahara_id        String?          @db.Uuid
  keterangan          String?          @db.Text
  status              PembayaranStatus @default(DRAFT)
  batas_waktu         DateTime?        // Deadline for TUP usage

  // Standard audit fields
  created_at DateTime @default(now())
  created_by String?  @db.Uuid
  updated_at DateTime @updatedAt
  updated_by String?  @db.Uuid
  is_deleted Boolean  @default(false)

  // Relations
  uang_persediaan    uang_persediaan      @relation(fields: [uang_persediaan_id], references: [id])
  paket              paket?               @relation(fields: [paket_id], references: [id])
  bendahara          users?               @relation("TUPBendahara", fields: [bendahara_id], references: [id])
  creator            users?               @relation("TUPCreatedBy", fields: [created_by], references: [id])
  updater            users?               @relation("TUPUpdatedBy", fields: [updated_by], references: [id])
  kuitansi           kuitansi[]
  pertanggungjawaban pertanggungjawaban[]

  @@index([uang_persediaan_id])
  @@index([paket_id])
  @@index([tanggal])
  @@index([status])
  @@index([is_deleted])
  @@schema("asisten")
}

/// Table 21: Kuitansi - Receipt/Invoice (Phase 2 Enhanced)
model kuitansi {
  id                  String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  nomor               String           @unique @db.VarChar(100)
  uang_persediaan_id  String?          @db.Uuid
  tup_id              String?          @db.Uuid  // Phase 2: Link to TUP
  perjalanan_dinas_id String?          @db.Uuid  // Phase 2: Link to travel
  dokumen_id          String?          @db.Uuid  // Phase 2: Link to dokumen engine
  kuitansi_um_id      String?          @db.Uuid  // Phase 2: For RAMPUNG, reference to UANG_MUKA
  tanggal             DateTime
  tipe                KuitansiTipe     @default(OPERASIONAL)  // Phase 2
  uraian              String           @db.Text
  nilai               Decimal          @db.Decimal(18, 2)
  nilai_um            Decimal?         @db.Decimal(18, 2)  // Phase 2: Uang Muka amount (for reconciliation)
  nilai_realisasi     Decimal?         @db.Decimal(18, 2)  // Phase 2: Actual spent amount
  selisih             Decimal?         @db.Decimal(18, 2)  // Phase 2: Difference (positive=return, negative=additional)
  penerima            String           @db.VarChar(255)
  jenis_belanja       String?          @db.VarChar(100)
  bukti_pendukung     String?          @db.VarChar(1000)
  status              PembayaranStatus @default(DRAFT)

  // Standard audit fields
  created_at DateTime @default(now())
  created_by String?  @db.Uuid
  updated_at DateTime @updatedAt
  updated_by String?  @db.Uuid
  is_deleted Boolean  @default(false)

  // Relations
  uang_persediaan     uang_persediaan?          @relation(fields: [uang_persediaan_id], references: [id])
  tup                 tambahan_uang_persediaan? @relation(fields: [tup_id], references: [id])
  perjalanan_dinas    perjalanan_dinas?         @relation(fields: [perjalanan_dinas_id], references: [id])
  dokumen             dokumen?                  @relation(fields: [dokumen_id], references: [id])
  kuitansi_um         kuitansi?                 @relation("KuitansiUMRef", fields: [kuitansi_um_id], references: [id])
  kuitansi_rampung    kuitansi[]                @relation("KuitansiUMRef")  // Phase 2: Reverse relation
  creator             users?                    @relation("KuitansiCreatedBy", fields: [created_by], references: [id])
  updater             users?                    @relation("KuitansiUpdatedBy", fields: [updated_by], references: [id])
  pertanggungjawaban  pertanggungjawaban[]

  @@index([uang_persediaan_id])
  @@index([tup_id])
  @@index([perjalanan_dinas_id])
  @@index([dokumen_id])
  @@index([kuitansi_um_id])
  @@index([tanggal])
  @@index([tipe])
  @@index([status])
  @@index([is_deleted])
  @@schema("asisten")
}

/// Table 22: Pertanggungjawaban - Accountability/SPJ (Phase 2 Enhanced)
model pertanggungjawaban {
  id                   String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  nomor                String           @unique @db.VarChar(100)
  uang_persediaan_id   String?          @db.Uuid
  tup_id               String?          @db.Uuid  // Phase 2: Link to TUP
  perjalanan_dinas_id  String?          @db.Uuid
  kuitansi_id          String?          @db.Uuid
  workflow_instance_id String?          @db.Uuid  // Phase 2: Link to workflow
  tanggal              DateTime
  jenis                String           @db.VarChar(100)
  total_nilai          Decimal          @db.Decimal(18, 2)
  total_um             Decimal?         @db.Decimal(18, 2)  // Phase 2: Total uang muka
  total_realisasi      Decimal?         @db.Decimal(18, 2)  // Phase 2: Total realization
  sisa_lebih           Decimal?         @db.Decimal(18, 2)  // Phase 2: Excess to return
  sisa_kurang          Decimal?         @db.Decimal(18, 2)  // Phase 2: Additional needed
  status               SPJStatus        @default(DRAFT)     // Phase 2: Enhanced status
  verifikator_id       String?          @db.Uuid
  tanggal_verifikasi   DateTime?
  catatan_verifikasi   String?          @db.Text
  pengesah_id          String?          @db.Uuid  // Phase 2: Final approver (PPK/Bendahara)
  tanggal_pengesahan   DateTime?        // Phase 2

  // Standard audit fields
  created_at DateTime @default(now())
  created_by String?  @db.Uuid
  updated_at DateTime @updatedAt
  updated_by String?  @db.Uuid
  is_deleted Boolean  @default(false)

  // Relations
  uang_persediaan   uang_persediaan?          @relation(fields: [uang_persediaan_id], references: [id])
  tup               tambahan_uang_persediaan? @relation(fields: [tup_id], references: [id])
  perjalanan_dinas  perjalanan_dinas?         @relation(fields: [perjalanan_dinas_id], references: [id])
  kuitansi          kuitansi?                 @relation(fields: [kuitansi_id], references: [id])
  workflow_instance workflow_instance?        @relation(fields: [workflow_instance_id], references: [id])
  verifikator       users?                    @relation("SPJVerifikator", fields: [verifikator_id], references: [id])
  pengesah          users?                    @relation("SPJPengesah", fields: [pengesah_id], references: [id])
  creator           users?                    @relation("SPJCreatedBy", fields: [created_by], references: [id])
  updater           users?                    @relation("SPJUpdatedBy", fields: [updated_by], references: [id])

  @@index([uang_persediaan_id])
  @@index([tup_id])
  @@index([perjalanan_dinas_id])
  @@index([kuitansi_id])
  @@index([workflow_instance_id])
  @@index([tanggal])
  @@index([status])
  @@index([is_deleted])
  @@schema("asisten")
}

