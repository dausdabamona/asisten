/// Table 24: HPS - Harga Perkiraan Sendiri (Owner's Estimate)
model hps {
  id              String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  nomor           String         @unique @db.VarChar(100)
  paket_id        String         @db.Uuid
  kak_id          String         @db.Uuid
  dokumen_id      String?        @db.Uuid
  tanggal_hps     DateTime
  nilai_hps       Decimal        @db.Decimal(18, 2)
  komponen_biaya  Json?          // Breakdown of cost components
  dasar_penyusun  String?        @db.Text  // Basis for estimation
  penyusun_id     String?        @db.Uuid
  status          HPSStatus      @default(DRAFT)
  catatan         String?        @db.Text

  // Standard audit fields
  created_at DateTime @default(now())
  created_by String?  @db.Uuid
  updated_at DateTime @updatedAt
  updated_by String?  @db.Uuid
  is_deleted Boolean  @default(false)

  // Relations
