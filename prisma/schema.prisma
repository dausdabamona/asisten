  npwp         String?  @db.VarChar(30)
  nama_wp      String?  @db.VarChar(255)
  catatan      String?  @db.Text

  // Standard audit fields
  created_at DateTime @default(now())
  created_by String?  @db.Uuid
  updated_at DateTime @updatedAt
  updated_by String?  @db.Uuid
  is_deleted Boolean  @default(false)

  // Relations
  spp spp @relation(fields: [spp_id], references: [id], onDelete: Cascade)

  @@index([spp_id])
  @@index([jenis_pajak])
  @@index([is_deleted])
  @@schema("asisten")
}

/// Table 39: Rekening Penyedia - Vendor Bank Account
model rekening_penyedia {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  kontrak_id    String   @db.Uuid
  nama_bank     String   @db.VarChar(100)
  cabang_bank   String?  @db.VarChar(100)
  nomor_rekening String  @db.VarChar(50)
  nama_rekening String   @db.VarChar(255)
  is_primary    Boolean  @default(false)

  // Standard audit fields
  created_at DateTime @default(now())
  created_by String?  @db.Uuid
  updated_at DateTime @updatedAt
  updated_by String?  @db.Uuid
  is_deleted Boolean  @default(false)

  // Relations
  kontrak kontrak @relation(fields: [kontrak_id], references: [id], onDelete: Cascade)
  creator users?  @relation("RekeningCreatedBy", fields: [created_by], references: [id])
  updater users?  @relation("RekeningUpdatedBy", fields: [updated_by], references: [id])

  @@index([kontrak_id])
  @@index([is_deleted])
  @@schema("asisten")
}
