# =============================================================================
# ASISTEN - Environment Configuration
# Copy this file to .env and update values
# =============================================================================

# PostgreSQL Database Connection
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://postgres:password@localhost:5432/asisten_db?schema=asisten"

# For Windows local PostgreSQL (default installation)
# DATABASE_URL="postgresql://postgres:your_password@localhost:5432/asisten_db?schema=asisten"

# Application Settings
NODE_ENV=development
APP_PORT=3000

# Security
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_EXPIRES_IN=24h

# File Storage (for documents)
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760
